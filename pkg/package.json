{
  "name": "langjs-sdk",
  "version": "1.0.0",
  "description": "Zero-config client-side internationalization SDK and dynamic 100+ language translation engine for modern web applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
